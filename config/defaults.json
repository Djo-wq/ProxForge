{
  "schema_version": 1,
  "default_profile": "standard",
  "rollback_mode": "auto",
  "start_vm": true,
  "allow_official_tls_checksum": false,
  "image_cache_dir": "/var/lib/proxforge/cache",
  "image_max_bytes": 107374182400,
  "image_download_timeout_seconds": 14400,
  "image_lock_timeout_seconds": 1800,
  "tmp_dir": "/var/lib/proxforge/tmp",
  "state_dir": "/var/lib/proxforge/state",
  "log_dir": "/var/log/proxforge",
  "log_level": "INFO"
}
