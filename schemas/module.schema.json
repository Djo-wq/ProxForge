{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxforge.invalid/schemas/module.schema.json",
  "title": "ProxForge module metadata",
  "description": "JSON projection of the mandatory Bash module metadata globals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "name", "family", "version", "architectures"],
  "properties": {
    "api_version": {"type": "string", "const": "1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "family": {"type": "string", "enum": ["redhat", "debian"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"},
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["x86_64"]}
    }
  }
}